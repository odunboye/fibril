-- Ordinary Fibril definitions. prim*, IO and ReadResult form the primitive boundary.
-- This initial interface is restricted to Type0 and linear bind results.
putStrLn : (1 text : String) -> IO Unit
putStrLn = \(1 text : String) => primWriteLine text

pure : (0 A : Type 0) -> (1 value : A) -> IO A
pure = \(0 A : Type 0) => \(1 value : A) => primPure A value

bind : (0 A : Type 0) -> (0 B : Type 0) -> (1 action : IO A) -> (1 next : (1 value : A) -> IO B) -> IO B
bind = \(0 A : Type 0) => \(0 B : Type 0) => \(1 action : IO A) => \(1 next : (1 value : A) -> IO B) => primBind A B action next

-- Input is available only through explicitly selected interactive execution.
readLine : IO ReadResult
readLine = primReadLine

-- Branches are unrestricted; line/error payloads are linear. Branch callbacks
-- cannot capture linear ambient resources through this initial interface.
readCase : (0 A : Type 0) -> (1 result : ReadResult) -> (eof : A) -> (line : (1 text : String) -> A) -> (error : (1 message : String) -> A) -> A
readCase = \(0 A : Type 0) => \(1 result : ReadResult) => \(eof : A) => \(line : (1 text : String) -> A) => \(error : (1 message : String) -> A) => primReadCase A result eof line error

-- Transform a returned value without extracting it from IO or adding a primitive.
map : (0 A : Type 0) -> (0 B : Type 0) -> (1 transform : (1 value : A) -> B) -> (1 action : IO A) -> IO B
map = \(0 A : Type 0) => \(0 B : Type 0) => \(1 transform : (1 value : A) -> B) => \(1 action : IO A) => bind A B action (\(1 value : A) => pure B (transform value))

-- Pure String computation; both operands are consumed exactly once.
appendString : (1 left : String) -> (1 right : String) -> String
appendString = \(1 left : String) => \(1 right : String) => primStringAppend left right

-- Exact text comparison, returning Bool rather than a dependent equality proof.
equalString : (1 left : String) -> (1 right : String) -> Bool
equalString = \(1 left : String) => \(1 right : String) => primStringEqual left right

-- Boolean logic derived from elimination, not additional primitive instructions.
notBool : (1 value : Bool) -> Bool
notBool = \(1 value : Bool) => if value then False else True

-- Both inputs are consumed. These are not short-circuiting operators.
andBool : (1 left : Bool) -> (1 right : Bool) -> Bool
andBool = \(1 left : Bool) => \(1 right : Bool) => if left then right else if right then False else False

orBool : (1 left : Bool) -> (1 right : Bool) -> Bool
orBool = \(1 left : Bool) => \(1 right : Bool) => if left then (if right then True else True) else right
