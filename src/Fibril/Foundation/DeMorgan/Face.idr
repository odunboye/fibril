module Fibril.Foundation.DeMorgan.Face

import Data.List

%default total

||| Face formulas, distinct from interval expressions.
public export
data Face
  = Bottom
  | Top
  | Endpoint Nat Bool
  | Conjunction Face Face
  | Disjunction Face Face

Atom : Type
Atom = (Nat, Bool)

Clause : Type
Clause = List Atom

DNF : Type
DNF = List Clause

canonical : Ord a => List a -> List a
canonical = nub . sort

subset : Clause -> Clause -> Bool
subset xs ys = all (\x => elem x ys) xs

consistent : Clause -> Bool
consistent xs = not (any (\(n, b) => elem (n, not b) xs) xs)

reduce : DNF -> DNF
reduce clauses =
  let unique = canonical (filter consistent (map canonical clauses))
   in filter (\c => not (any (\d => d /= c && subset d c) unique)) unique

normal : Face -> DNF
normal Bottom = []
normal Top = [[]]
normal (Endpoint n b) = [[(n, b)]]
normal (Disjunction x y) = reduce (normal x ++ normal y)
normal (Conjunction x y) =
  reduce (concatMap (\a => map (\b => a ++ b) (normal y)) (normal x))

||| Entailment in the face lattice generated by endpoint constraints, with
||| opposite endpoints disjoint but not jointly exhaustive.
public export
entails : Face -> Face -> Bool
entails premise conclusion =
  all (\p => any (\q => subset q p) (normal conclusion)) (normal premise)

public export
equivalentFace : Face -> Face -> Bool
equivalentFace x y = normal x == normal y
