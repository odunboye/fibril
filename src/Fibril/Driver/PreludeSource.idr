preludeSource = "-- Ordinary Fibril definitions. Only prim* and the IO type constructor are primitive.\n-- This initial interface is restricted to Type0 and linear bind results.\nputStrLn : (1 text : String) -> IO Unit\nputStrLn = \\(1 text : String) => primWriteLine text\n\npure : (0 A : Type 0) -> (1 value : A) -> IO A\npure = \\(0 A : Type 0) => \\(1 value : A) => primPure A value\n\nbind : (0 A : Type 0) -> (0 B : Type 0) -> (1 action : IO A) -> (1 next : (1 value : A) -> IO B) -> IO B\nbind = \\(0 A : Type 0) => \\(0 B : Type 0) => \\(1 action : IO A) => \\(1 next : (1 value : A) -> IO B) => primBind A B action next\n\n-- Transform a returned value without extracting it from IO or adding a primitive.\nmap : (0 A : Type 0) -> (0 B : Type 0) -> (1 transform : (1 value : A) -> B) -> (1 action : IO A) -> IO B\nmap = \\(0 A : Type 0) => \\(0 B : Type 0) => \\(1 transform : (1 value : A) -> B) => \\(1 action : IO A) => bind A B action (\\(1 value : A) => pure B (transform value))\n\n-- Pure String computation; both operands are consumed exactly once.\nappendString : (1 left : String) -> (1 right : String) -> String\nappendString = \\(1 left : String) => \\(1 right : String) => primStringAppend left right\n"
