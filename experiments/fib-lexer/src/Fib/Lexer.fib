module Fib.Lexer

-- A Fibril lexer written in Fibril, over Bytes. It follows Fibril.Source.Lexer.scan:
-- comments, whitespace, strings, names/keywords, numbers, symbol runs and punctuation.
-- Output is text, one token per line: "<start>-<end> <kind>" with half-open BYTE offsets.
-- A lexical error ends the output with "<offset> error". Not ported: string-escape
-- validation, source-control validation, the (+) name collapse, line/column tracking.

record SharedBytes : Type where
  constructor Shared
  bytes : Bytes

-- Byte at a position as a Word; 256w (not a byte value) past the end, so NUL is not end of input.
byteAt : (pos : Nat) -> (src : Bytes) -> Word
byteAt pos src = primBytesIndexCase Word (primBytesIndex pos src) 256w
  (\(1 n : Nat) => primWordFromNat n)

between : (lo : Word) -> (hi : Word) -> (c : Word) -> Bool
between lo hi c = andBool (notBool (primWordLt c lo)) (primWordLt c hi)

isDigit : (c : Word) -> Bool
isDigit c = between 48w 58w c

isLetter : (c : Word) -> Bool
isLetter c = orBool (between 97w 123w c) (between 65w 91w c)

isNameStart : (c : Word) -> Bool
isNameStart c = orBool (isLetter c) (primWordEq c 95w)

isNameRest : (c : Word) -> Bool
isNameRest c = orBool (isNameStart c) (orBool (isDigit c) (primWordEq c 39w))

isSpace : (c : Word) -> Bool
isSpace c = orBool (primWordEq c 32w) (orBool (primWordEq c 10w) (orBool (primWordEq c 13w) (primWordEq c 9w)))

-- ! # $ % & * + - / : < = > ? @ ^ | ~
isSymbol : (c : Word) -> Bool
isSymbol c = orBool (primWordEq c 33w) (orBool (between 35w 39w c) (orBool (between 42w 44w c)
  (orBool (primWordEq c 45w) (orBool (primWordEq c 47w) (orBool (primWordEq c 58w)
  (orBool (between 60w 65w c) (orBool (primWordEq c 94w) (orBool (primWordEq c 124w) (primWordEq c 126w)))))))))

-- Not a line end, a NUL, or the end of input (the scanner then reports a NUL as an error).
notEol : (c : Word) -> Bool
notEol c = andBool (notBool (primWordEq c 10w)) (andBool (notBool (primWordEq c 13w)) (notBool (orBool (primWordEq c 0w) (primWordEq c 256w))))

natWord : (n : Nat) -> Word
natWord n = primWordFromNat n

natText : (n : Nat) -> String
natText n = primWordToString (primWordFromNat n)

-- One output line.
line : (start : Nat) -> (end : Nat) -> (kind : String) -> String
line start end kind = appendString (natText start) (appendString "-"
  (appendString (natText end) (appendString " " (appendString kind "\n"))))

failure : (pos : Nat) -> String
failure pos = appendString (natText pos) " error\n"

-- Keyword spelling or "name".
keyword : (text : String) -> String
keyword text =
  if equalString text "String" then "String"
  else if equalString text "Type" then "Type"
  else if equalString text "Unit" then "Unit"
  else if equalString text "Bool" then "Bool"
  else if equalString text "True" then "True"
  else if equalString text "False" then "False"
  else if equalString text "if" then "if"
  else if equalString text "then" then "then"
  else if equalString text "else" then "else"
  else if equalString text "do" then "do"
  else if equalString text "case" then "case"
  else if equalString text "of" then "of"
  else if equalString text "let" then "let"
  else if equalString text "in" then "in"
  else if equalString text "projection" then "projection"
  else if equalString text "return" then "return"
  else if equalString text "data" then "data"
  else if equalString text "record" then "record"
  else if equalString text "interface" then "interface"
  else if equalString text "mutual" then "mutual"
  else if equalString text "implementation" then "implementation"
  else if equalString text "constructor" then "constructor"
  else if equalString text "eliminator" then "eliminator"
  else if equalString text "where" then "where"
  else if equalString text "module" then "module"
  else if equalString text "import" then "import"
  else if equalString text "export" then "export"
  else "name"

-- Truncated subtraction; unary, so it costs the size of the subtrahend.
monus : (left : Nat) -> (right : Nat) -> Nat
monus left right = natRec (\(0 n : Nat) => Nat) left
  (\(0 n : Nat) => \(1 previous : Nat) => case previous of
    Zero => Zero
    Succ k => k) right

-- The text of [start, end); empty if it is not valid UTF-8. Returning the linear text from
-- the branch lets the caller use it more than once.
sliceText : (src : Bytes) -> (start : Nat) -> (end : Nat) -> String
sliceText src start end = primUTF8Case String String
  (primUTF8Decode (primBytesSlice start (monus end start) src)) ""
  (\(1 text : String) => text)

nameKind : (src : Bytes) -> (start : Nat) -> (end : Nat) -> String
nameKind src start end = keyword (sliceText src start end)

-- "=", "|" and ":" alone are their own kinds; any other run is an operator.
symbolKind : (c : Word) -> (single : Bool) -> String
symbolKind c single =
  if single then (if primWordEq c 61w then "=" else if primWordEq c 124w then "|" else if primWordEq c 58w then ":" else "operator")
  else "operator"

-- Kind of a single-byte punctuation token, or "" for any other byte.
punct : (c : Word) -> String
punct c =
  if primWordEq c 96w then "`"
  else if primWordEq c 46w then "."
  else if primWordEq c 44w then ","
  else if primWordEq c 40w then "("
  else if primWordEq c 41w then ")"
  else if primWordEq c 123w then "{"
  else if primWordEq c 125w then "}"
  else if primWordEq c 92w then "lambda"
  else ""

-- One flat state machine, because a general-recursive function may not call another one (the
-- size-change gate refuses a nested Fix) and may not take a Bytes parameter (so it reads
-- through rd instead). Modes: 0 between tokens, 2 comment, 3 name, 4 number, 5 string,
-- 6 string escape, 7 symbol run. A run ends by emitting its token and re-reading the same
-- byte in mode 0, so the fuel is twice the input length plus 3; running out is reported as an error.
scan : (fuel : Nat) -> (rd : (p : Nat) -> Word) -> (nk : (start : Nat) -> (end : Nat) -> String) -> (m : Word) -> (start : Nat) -> (pos : Nat) -> (acc : String) -> String
scan fuel rd nk m start pos acc = case fuel of
  Zero => appendString acc (failure pos)
  Succ f => (\(c : Word) => (\(d : Word) =>
    if primWordEq m 3w then
      (if isNameRest c then scan f rd nk 3w start (Succ pos) acc
       else scan f rd nk 0w pos pos (appendString acc (line start pos (nk start pos))))
    else if primWordEq m 4w then
      (if isDigit c then scan f rd nk 4w start (Succ pos) acc
       else scan f rd nk 0w pos pos (appendString acc (line start pos "number")))
    else if primWordEq m 7w then
      (if isSymbol c then scan f rd nk 7w start (Succ pos) acc
       else scan f rd nk 0w pos pos (appendString acc (line start pos
         (symbolKind (rd start) (primWordEq (natWord pos) (primWordAdd (natWord start) 1w))))))
    else if primWordEq m 2w then
      (if notEol c then scan f rd nk 2w start (Succ pos) acc else scan f rd nk 0w pos pos acc)
    else if primWordEq m 5w then
      (if orBool (primWordEq c 0w) (primWordEq c 256w) then appendString acc (failure start)
       else if primWordEq c 34w then scan f rd nk 0w (Succ pos) (Succ pos) (appendString acc (line start (Succ pos) "string"))
       else if primWordEq c 92w then scan f rd nk 6w start (Succ pos) acc
       else scan f rd nk 5w start (Succ pos) acc)
    else if primWordEq m 6w then
      (if orBool (primWordEq c 0w) (primWordEq c 256w) then appendString acc (failure start) else scan f rd nk 5w start (Succ pos) acc)
    else if primWordEq c 256w then acc
    else if primWordEq c 34w then scan f rd nk 5w pos (Succ pos) acc
    else if andBool (primWordEq c 45w) (primWordEq d 45w) then scan f rd nk 2w pos (Succ (Succ pos)) acc
    else if andBool (primWordEq c 45w) (primWordEq d 62w) then scan f rd nk 0w (Succ (Succ pos)) (Succ (Succ pos)) (appendString acc (line pos (Succ (Succ pos)) "->"))
    else if andBool (primWordEq c 60w) (primWordEq d 45w) then scan f rd nk 0w (Succ (Succ pos)) (Succ (Succ pos)) (appendString acc (line pos (Succ (Succ pos)) "<-"))
    else if andBool (primWordEq c 61w) (primWordEq d 62w) then scan f rd nk 0w (Succ (Succ pos)) (Succ (Succ pos)) (appendString acc (line pos (Succ (Succ pos)) "=>"))
    else if andBool (primWordEq c 64w) (primWordEq d 123w) then scan f rd nk 0w (Succ (Succ pos)) (Succ (Succ pos)) (appendString acc (line pos (Succ (Succ pos)) "@{"))
    else if isSymbol c then scan f rd nk 7w pos (Succ pos) acc
    else if isSpace c then scan f rd nk 0w pos (Succ pos) acc
    else if isNameStart c then scan f rd nk 3w pos (Succ pos) acc
    else if isDigit c then scan f rd nk 4w pos (Succ pos) acc
    else if notBool (equalString (punct c) "") then scan f rd nk 0w (Succ pos) (Succ pos) (appendString acc (line pos (Succ pos) (punct c)))
    else if andBool (primWordEq c 206w) (primWordEq d 187w) then scan f rd nk 0w (Succ (Succ pos)) (Succ (Succ pos)) (appendString acc (line pos (Succ (Succ pos)) "lambda"))
    else if andBool (primWordEq c 226w) (andBool (primWordEq d 134w) (primWordEq (rd (Succ (Succ pos))) 146w)) then scan f rd nk 0w (Succ (Succ (Succ pos))) (Succ (Succ (Succ pos))) (appendString acc (line pos (Succ (Succ (Succ pos))) "->"))
    else if andBool (primWordEq c 226w) (andBool (primWordEq d 135w) (primWordEq (rd (Succ (Succ pos))) 146w)) then scan f rd nk 0w (Succ (Succ (Succ pos))) (Succ (Succ (Succ pos))) (appendString acc (line pos (Succ (Succ (Succ pos))) "=>"))
    else appendString acc (failure pos)) (rd (Succ pos))) (rd pos)

double : (n : Nat) -> Nat
double n = natRec (\(0 k : Nat) => Nat) Zero (\(0 k : Nat) => \(1 r : Nat) => Succ (Succ r)) n

-- Lex a whole input. Errors end the output with an "<offset> error" line.
export
lexBytes : (1 input : Bytes) -> String
lexBytes input = case primBytesShare input of
  Shared src => scan (Succ (Succ (Succ (double (primBytesLength src))))) (\(p : Nat) => byteAt p src)
    (\(start : Nat) => \(end : Nat) => nameKind src start end) 0w Zero Zero ""

-- Lex source text (encodes it to UTF-8 first).
export
lexText : (text : String) -> String
lexText text = primUTF8Case Bytes String (primUTF8Encode text) "invalid text\n"
  (\(1 bytes : Bytes) => lexBytes bytes)
