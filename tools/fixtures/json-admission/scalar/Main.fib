module Main
import Protocol.JSONScalar

main : IO Unit
main = bind ByteReadResult Unit (primReadBytes (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ Zero))))))))))))))))) (\(1 result : ByteReadResult) => primByteReadCase (IO Unit) result primRejectBytes (\(1 input : Bytes) => case parseJSONScalar input of
  InvalidScalar => primWriteBytes (primBytesOctetMod256 Zero)
  ScalarTokens tokens => primWriteBytes tokens))
