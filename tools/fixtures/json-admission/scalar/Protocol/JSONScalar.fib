module Protocol.JSONScalar

record SharedBytes : Type where
  constructor Shared
  bytes : Bytes

record Scan : Type where
  constructor Scanning
  eliminator consumeScan
  rest : Bytes
  mode : String
  tokens : Bytes

export
data JSONScalarResult : Type where
  InvalidScalar : JSONScalarResult
  ScalarTokens : (1 tokens : Bytes) -> JSONScalarResult

-- Reduced admission probe: numbers, booleans and null only; not full JSON.
export
parseJSONScalar : (1 input : Bytes) -> JSONScalarResult
parseJSONScalar input = case primBytesShare input of Shared original =>
  let (bytesLimit : Bytes) = primUTF8Case Bytes Bytes (primUTF8Encode "................................................................") primBytesEmpty (\(1 b : Bytes) => b) in
  let (one : Nat) = Succ (Zero) in
  let (limit : Nat) = primBytesLength (bytesLimit) in
  let (ascii : (b : Bytes) -> String) = \(b : Bytes) => primUTF8Case String String (primUTF8Decode b) "" (\(1 text : String) => text) in
  let (bytes : (text : String) -> Bytes) = \(text : String) => primUTF8Case Bytes Bytes (primUTF8Encode text) primBytesEmpty (\(1 b : Bytes) => b) in
  let (head : (b : Bytes) -> Bytes) = \(b : Bytes) => primBytesSlice Zero one b in
  let (tail : (b : Bytes) -> Bytes) = \(b : Bytes) => primBytesSlice one limit b in
  let (zero : Bytes) = primBytesOctetMod256 Zero in
  let (digit : (c : String) -> Bool) = \(c : String) => orBool (equalString c "0") ( orBool (equalString c "1") ( orBool (equalString c "2") ( orBool (equalString c "3") ( orBool (equalString c "4") ( orBool (equalString c "5") ( orBool (equalString c "6") ( orBool (equalString c "7") ( orBool (equalString c "8") (equalString c "9"))))))))) in
  let (space : (c : String) -> Bool) = \(c : String) => orBool (equalString c " ") ( orBool (equalString c "\t") ( orBool (equalString c "\r") (equalString c "\n"))) in
  let (step : (1 state : Scan) -> Scan) = \(1 state : Scan) => consumeScan (\(0 self : Scan) => Scan) state (\(rest : Bytes) => \(mode : String) => \(tokens : Bytes) =>
    case primBytesShare (head rest) of Shared octet =>
    let (c : String) = ascii octet in
    let (r : Bytes) = tail rest in
    let (bad : Scan) = Scanning r "!" tokens in
    let (keep : (m : String) -> Scan) = \(m : String) => Scanning r m (primBytesAppend tokens octet) in
    let (lex : (m : String) -> Scan) = \(m : String) => Scanning r m tokens in
    let (structural : (out : Bytes) -> Scan) = \(out : Bytes) => if space c then Scanning r "done" out else bad in
    if equalString mode "!" then bad
    else if equalString mode "done" then structural tokens
    else if equalString mode "" then
      if space c then lex ""
      else if equalString c "t" then Scanning r "t1" (bytes "T")
      else if equalString c "f" then Scanning r "f1" (bytes "F")
      else if equalString c "n" then Scanning r "n1" (bytes "N")
      else if equalString c "-" then Scanning r "minus" (bytes "#-")
      else if digit c then Scanning r (if equalString c "0" then "zero" else "int") (bytes (appendString "#" c))
      else bad
    else if equalString mode "minus" then if digit c then keep (if equalString c "0" then "zero" else "int") else bad
    else if equalString mode "zero" then if equalString c "." then keep "dot" else if orBool (equalString c "e") (equalString c "E") then keep "exp" else structural (primBytesAppend tokens zero)
    else if equalString mode "int" then if digit c then keep "int" else if equalString c "." then keep "dot" else if orBool (equalString c "e") (equalString c "E") then keep "exp" else structural (primBytesAppend tokens zero)
    else if equalString mode "dot" then if digit c then keep "frac" else bad
    else if equalString mode "frac" then if digit c then keep "frac" else if orBool (equalString c "e") (equalString c "E") then keep "exp" else structural (primBytesAppend tokens zero)
    else if equalString mode "exp" then if digit c then keep "en" else if orBool (equalString c "+") (equalString c "-") then keep "sign" else bad
    else if equalString mode "sign" then if digit c then keep "en" else bad
    else if equalString mode "en" then if digit c then keep "en" else structural (primBytesAppend tokens zero)
    else if equalString mode "t1" then if equalString c "r" then lex "t2" else bad
    else if equalString mode "t2" then if equalString c "u" then lex "t3" else bad
    else if equalString mode "t3" then if equalString c "e" then lex "done" else bad
    else if equalString mode "f1" then if equalString c "a" then lex "f2" else bad
    else if equalString mode "f2" then if equalString c "l" then lex "f3" else bad
    else if equalString mode "f3" then if equalString c "s" then lex "f4" else bad
    else if equalString mode "f4" then if equalString c "e" then lex "done" else bad
    else if equalString mode "n1" then if equalString c "u" then lex "n2" else bad
    else if equalString mode "n2" then if equalString c "l" then lex "n3" else bad
    else if equalString mode "n3" then if equalString c "l" then lex "done" else bad
    else bad) in
  if primBytesLengthIs one (primBytesSlice limit one original) then InvalidScalar else
  primUTF8Case String JSONScalarResult (primUTF8Decode original) InvalidScalar (\(1 text : String) =>
    case primBytesShare (primUTF8Case Bytes Bytes (primUTF8Encode text) primBytesEmpty (\(1 b : Bytes) => b)) of Shared validated =>
    consumeScan (\(0 self : Scan) => JSONScalarResult)
      (natRec (\(0 n : Nat) => Scan) (Scanning validated "" primBytesEmpty) (\(0 n : Nat) => \(1 state : Scan) => step state) (primBytesLength validated))
      (\(rest : Bytes) => \(mode : String) => \(tokens : Bytes) =>
        if equalString mode "done" then ScalarTokens tokens
        else if orBool (equalString mode "zero") (orBool (equalString mode "int") (orBool (equalString mode "frac") (equalString mode "en"))) then ScalarTokens (primBytesAppend tokens zero)
        else InvalidScalar))
