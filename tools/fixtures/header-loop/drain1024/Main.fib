module Main

-- NON-PRODUCTION: isolate lazy state forwarding, with no reads/classification.
main : IO Unit
main =
  let (encode : (text : String) -> Bytes) = \(text : String) => primUTF8Case Bytes Bytes (primUTF8Encode text) primBytesEmpty (\(1 bytes : Bytes) => bytes) in
  let (limit : Nat) = primBytesLength (encode "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx") in
  let (finish : (saved : Bytes) -> IO Unit) = \(saved : Bytes) => primWriteBytes saved in
  let (step : (0 n : Nat) -> (1 next : (saved : Bytes) -> IO Unit) -> (saved : Bytes) -> IO Unit) = \(0 n : Nat) => \(1 next : (saved : Bytes) -> IO Unit) => \(saved : Bytes) =>
    bind Unit Unit (pure Unit ()) (\(1 done : Unit) => case done of () => next saved) in
  let (block : (1 tail : (saved : Bytes) -> IO Unit) -> (saved : Bytes) -> IO Unit) = \(1 tail : (saved : Bytes) -> IO Unit) => natRec (\(0 n : Nat) => (saved : Bytes) -> IO Unit) tail step limit in
  (natRec (\(0 n : Nat) => (saved : Bytes) -> IO Unit) finish (\(0 n : Nat) => \(1 tail : (saved : Bytes) -> IO Unit) => block tail) limit) primBytesEmpty
