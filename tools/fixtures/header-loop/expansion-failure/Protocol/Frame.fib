module Protocol.Frame

-- NON-PRODUCTION diagnostic checkpoint; see docs/header-parser-blockers.md.

-- Bounded ASCII headers; bodies remain opaque, with a 4096-byte cap.
record SharedBytes : Type where
  constructor Shared
  bytes : Bytes

record Scanner : Type where
  constructor More
  run : (phase : String) -> (name : String) -> (value : String) -> (saved : Bytes) -> (length : String) -> (typed : Bool) -> (lines : String) -> IO Unit

withHeader : (onFrame : (header : Bytes) -> (1 body : Bytes) -> IO Unit) -> IO Unit
withHeader = \(onFrame : (header : Bytes) -> (1 body : Bytes) -> IO Unit) =>
  let (one : Nat) = Succ (Zero) in
  let (three : Nat) = Succ (Succ (Succ (Zero))) in
  let (ascii : (bytes : Bytes) -> String) = \(bytes : Bytes) => primUTF8Case String String (primUTF8Decode bytes) "" (\(1 text : String) => text) in
  let (encode : (text : String) -> Bytes) = \(text : String) => primUTF8Case Bytes Bytes (primUTF8Encode text) primBytesEmpty (\(1 bytes : Bytes) => bytes) in
  let (lowerTable : Bytes) = encode "\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t !\"#$%&'()*+,-./0123456789:;<=>?@abcdefghijklmnopqrstuvwxyz[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~" in
  let (lower : (bytes : Bytes) -> String) = \(bytes : Bytes) => primBytesIndexCase String (primBytesIndex Zero bytes) "" (\(1 code : Nat) => ascii (primBytesSlice code one lowerTable)) in
  let (token : (text : String) -> Bool) = \(text : String) => if equalString text "" then False else if equalString text " " then False else if equalString text "\t" then False else if equalString text "(" then False else if equalString text ")" then False else if equalString text "<" then False else if equalString text ">" then False else if equalString text "@" then False else if equalString text "," then False else if equalString text ";" then False else if equalString text ":" then False else if equalString text "\\" then False else if equalString text "\"" then False else if equalString text "/" then False else if equalString text "[" then False else if equalString text "]" then False else if equalString text "?" then False else if equalString text "=" then False else if equalString text "{" then False else if equalString text "}" then False else True in
  let (classify : (text : String) -> (cr : IO Unit) -> (digit : (value : Nat) -> (spelling : String) -> IO Unit) -> IO Unit) = \(text : String) => \(cr : IO Unit) => \(digit : (value : Nat) -> (spelling : String) -> IO Unit) => if equalString text "0" then digit Zero "0" else if equalString text "1" then digit one "1" else if equalString text "2" then digit (Succ one) "2" else if equalString text "3" then digit three "3" else if equalString text "4" then digit (Succ three) "4" else if equalString text "5" then digit (Succ (Succ three)) "5" else if equalString text "6" then digit (Succ (Succ (Succ three))) "6" else if equalString text "7" then digit (Succ (Succ (Succ (Succ three)))) "7" else if equalString text "8" then digit (Succ (Succ (Succ (Succ (Succ three))))) "8" else if equalString text "9" then digit (Succ (Succ (Succ (Succ (Succ (Succ three)))))) "9" else if equalString text "\r" then cr else primRejectBytes in
  let (digitBytes : (value : Nat) -> Bytes) = \(value : Nat) => natRec (\(0 n : Nat) => Bytes) primBytesEmpty (\(0 n : Nat) => \(1 old : Bytes) => primBytesAppend old (primBytesOctetMod256 Zero)) value in
  let (tenBytes : (value : Bytes) -> Bytes) = \(value : Bytes) => let (twice : Bytes) = primBytesAppend value value in let (four : Bytes) = primBytesAppend twice twice in let (eight : Bytes) = primBytesAppend four four in primBytesAppend eight twice in
  let (safeFourth : (a : String) -> (b : String) -> (c : String) -> (d : String) -> Bool) = \(a : String) => \(b : String) => \(c : String) => \(d : String) => if orBool (equalString a "1") (orBool (equalString a "2") (equalString a "3")) then True else if equalString a "4" then if equalString b "0" then if equalString c "9" then if orBool (equalString d "7") (orBool (equalString d "8") (equalString d "9")) then False else True else True else False else False in
  let (body : (count : Nat) -> (saved : Bytes) -> IO Unit) = \(count : Nat) => \(saved : Bytes) => if primBytesLengthIs count primBytesEmpty then onFrame saved primBytesEmpty else bind ByteReadResult Unit (primReadBytes count) (\(1 r : ByteReadResult) => primByteReadCase (IO Unit) r primRejectBytes (\(1 b : Bytes) => case primBytesShare b of Shared value => if primBytesLengthIs count value then onFrame saved value else primRejectBytes)) in
  let (at : (index : Nat) -> (bytes : Bytes) -> String) = \(index : Nat) => \(bytes : Bytes) => ascii (primBytesSlice index one bytes) in
  let (number : (text : String) -> (saved : Bytes) -> IO Unit) = \(text : String) => \(saved : Bytes) => case primBytesShare (encode text) of Shared digits =>
    let (a : String) = at Zero digits in
    let (b : String) = at one digits in
    let (c : String) = at (Succ one) digits in
    let (d : String) = at three digits in
    let (end : String) = at (Succ three) digits in
    classify a primRejectBytes (\(av : Nat) => \(aa : String) =>
      case primBytesShare (digitBytes av) of Shared first =>
      if equalString b "" then body (primBytesLength first) saved else if equalString a "0" then primRejectBytes else
      classify b primRejectBytes (\(bv : Nat) => \(bb : String) =>
        case primBytesShare (primBytesAppend (tenBytes first) (digitBytes bv)) of Shared second =>
        if equalString c "" then body (primBytesLength second) saved else
        classify c primRejectBytes (\(cv : Nat) => \(cc : String) =>
          case primBytesShare (primBytesAppend (tenBytes second) (digitBytes cv)) of Shared third =>
          if equalString d "" then body (primBytesLength third) saved else
          classify d primRejectBytes (\(dv : Nat) => \(dd : String) =>
            if andBool (equalString end "") (safeFourth aa bb cc dd) then
              case primBytesShare (primBytesAppend (tenBytes third) (digitBytes dv)) of Shared fourth => body (primBytesLength fourth) saved
            else primRejectBytes)))) in
  let (contentType : (value : String) -> Bool) = \(value : String) => if equalString value "application/vscode-jsonrpc" then True else if equalString value "application/vscode-jsonrpc; charset=utf-8" then True else equalString value "application/vscode-jsonrpc; charset=utf8" in
  let (limit : Nat) = primBytesLength (encode "") in
  let (scanner : Scanner) = natRec (\(0 n : Nat) => Scanner) (More (\(phase : String) => \(name : String) => \(value : String) => \(saved : Bytes) => \(length : String) => \(typed : Bool) => \(lines : String) => primRejectBytes))
    (\(0 n : Nat) => \(1 previous : Scanner) => case previous of More rest => More (\(phase : String) => \(name : String) => \(value : String) => \(saved : Bytes) => \(length : String) => \(typed : Bool) => \(lines : String) =>
      bind ByteReadResult Unit (primReadBytes one) (\(1 r : ByteReadResult) => primByteReadCase (IO Unit) r primRejectBytes (\(1 b : Bytes) => case primBytesShare b of Shared raw =>
        case primBytesShare (primBytesAppend saved raw) of Shared next =>
        let (text : String) = ascii raw in
        let (folded : String) = lower raw in
        if equalString phase "end" then if equalString text "\n" then if equalString length "" then primRejectBytes else number length next else primRejectBytes else
        if equalString phase "lf" then if equalString text "\n" then
          if equalString lines "xxxxxxxxxxxxxxxx" then primRejectBytes else
          if equalString name "content-length" then if equalString length "" then if equalString value "" then primRejectBytes else rest "name" "" "" next value typed (appendString lines "x") else primRejectBytes else
          if equalString name "content-type" then if typed then primRejectBytes else if contentType value then rest "name" "" "" next length True (appendString lines "x") else primRejectBytes else
          rest "name" "" "" next length typed (appendString lines "x")
        else primRejectBytes else
        if equalString phase "space" then if equalString text " " then rest "value" name "" next length typed lines else primRejectBytes else
        if equalString phase "name" then
          if equalString text "\r" then if equalString name "" then rest "end" name value next length typed lines else primRejectBytes else
          if equalString text ":" then if equalString name "" then primRejectBytes else rest "space" name value next length typed lines else
          if token folded then rest "name" (appendString name folded) value next length typed lines else primRejectBytes
        else if equalString text "\r" then rest "lf" name value next length typed lines else
          if orBool (equalString folded "") (equalString folded "\t") then primRejectBytes else rest "value" name (appendString value folded) next length typed lines
      )))) limit in
  case scanner of More scan => scan "name" "" "" primBytesEmpty "" False ""

export
withFrame : (onBody : (1 body : Bytes) -> IO Unit) -> IO Unit
withFrame = \(onBody : (1 body : Bytes) -> IO Unit) => withHeader (\(header : Bytes) => \(1 body : Bytes) => onBody body)

export
echoFrame : IO Unit
echoFrame = withHeader (\(header : Bytes) => \(1 body : Bytes) => bind Unit Unit (primWriteBytes (primBytesAppend header body)) (\(1 done : Unit) => case done of () => primFlushBytes))
