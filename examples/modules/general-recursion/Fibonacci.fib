module Fibonacci

add : (1 left : Nat) -> (1 right : Nat) -> Nat
add left right = natRec (\(0 k : Nat) => Nat) right
  (\(0 k : Nat) => \(1 result : Nat) => Succ result) left

-- Two recursive calls on different predecessors. The unrestricted argument lets the
-- pattern variable a be used twice; the size-change check sees both calls shrink.
fib : (n : Nat) -> Nat
fib n = case n of
  Zero => Zero
  Succ a => case a of
    Zero => Succ Zero
    Succ b => add (fib a) (fib b)

marks : (1 count : Nat) -> String
marks count = natRec (\(0 k : Nat) => String) ""
  (\(0 k : Nat) => \(1 result : String) => appendString result "!") count

main : IO Unit
main = putStrLn (marks (fib 4))
