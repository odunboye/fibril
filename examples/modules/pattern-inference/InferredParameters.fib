module InferredParameters

record Box (0 A : Type 0) : Type 0 where
  constructor MkBox
  1 value : A

record Package : Type 1 where
  constructor MkPackage
  0 Item : Type 0
  1 value : Item

0 payloadType : (0 package : Package) -> Type 0
payloadType = \(0 package : Package) => case package of MkPackage Item value => Item

recover : (1 package : Package) -> payloadType package
recover = \(1 package : Package) => case package of MkPackage Item value => value

unbox : (0 A : Type 0) -> (1 box : Box A) -> A
unbox = \(0 A : Type 0) => \(1 box : Box A) => case box of MkBox value => value

main : IO Unit
main = putStrLn (unbox String (MkBox String (recover (MkPackage String "Inferred parameters!"))))
