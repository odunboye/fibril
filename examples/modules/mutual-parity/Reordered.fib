module Reordered

-- A nondecreasing forwarding edge is eliminated before recursor construction.
export
mutual where
  first : (1 count : Nat) -> (1 flag : Bool) -> Bool
  first count flag = second flag count

  second : (1 flag : Bool) -> (1 count : Nat) -> Bool
  second flag count = case count of
    Zero => if flag then False else True
    Succ previous => first previous flag

main : IO Unit
main = do
  putStrLn (if first Zero False then "forwarded" else "wrong")
  putStrLn (if second False (Succ (Succ Zero)) then "reordered" else "wrong")
  putStrLn (if first (Succ Zero) True then "wrong" else "unchanged payload")
