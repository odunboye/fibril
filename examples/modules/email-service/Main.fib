module Main
import Delivery

main : IO Unit
main = do
  putStrLn (Delivery.transitionText (Delivery.advance Delivery.Queued Delivery.Dispatch))
  putStrLn (Delivery.transitionText (Delivery.advance Delivery.Sending Delivery.RelayAccepted))
  putStrLn (Delivery.transitionText (Delivery.advance Delivery.Sending Delivery.AcknowledgementLost))
  putStrLn (Delivery.transitionText (Delivery.advance Delivery.SubmissionUnknown Delivery.Dispatch))
