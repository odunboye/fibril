module Main

import Data.Items

join : (1 items : Data.Items.Items String) -> String
join items = case items of
  Data.Items.Empty => ""
  Data.Items.Prepend head tail => appendString head (Data.Items.foldItems String
    (\(0 self : Data.Items.Items String) => String) ""
    (\(1 item : String) => \(0 rest : Data.Items.Items String) =>
      \(1 result : String) => appendString item result) tail)

main : IO Unit
main = putStrLn (join (Data.Items.Prepend "hello" (Data.Items.Prepend " world" (Data.Items.Empty {String}))))
