module Main

data Request : Type where
  Health : Request
  Preview : (1 subject : String) -> Request

identity : (0 A : Type) -> (1 value : A) -> A
identity T item = item

describe : (1 prefix : String) -> (1 request : Request) -> String
describe prefix request = case request return (\(0 self : Request) => String) of
  Health => prefix
  Preview subject => appendString prefix subject

main : IO Unit
main = do
  putStrLn (describe "status: " Health)
  putStrLn (identity String (describe "preview: " (Preview "receipt")))
