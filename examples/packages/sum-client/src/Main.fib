module Main
import Data.Sum

render : (1 prefix : String) -> (1 item : Data.Sum.Sum String Bool) -> String
render = \(1 prefix : String) => \(1 item : Data.Sum.Sum String Bool) => case item return (\(0 self : Data.Sum.Sum String Bool) => String) of
  Data.Sum.Right flag => if flag then appendString prefix "yes" else appendString prefix "no"
  Data.Sum.Left text => appendString prefix text

main : IO Unit
main = do
  putStrLn (render "L: " (Data.Sum.Left String Bool "hello"))
  putStrLn (render "R: " (Data.Sum.Right String Bool True))
