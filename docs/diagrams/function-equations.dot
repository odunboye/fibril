digraph FunctionEquations {
  rankdir=LR;
  node [shape=box];
  source [label="Authored signature + equation\nactual parameter tokens"];
  pi [label="Explicit Pi telescope\ndomain + quantity in scoped context"];
  body [label="Ordinary generated core lambdas"];
  structural [label="Restricted immediate-tail self call\nchecked constructors + guarded admission"];
  fold [label="NatRec / unary RecFold\nerased tail + linear induction result"];
  check [label="Independent core checker\ntyping + erased/runtime usage"];
  source -> pi -> body -> check;
  source -> structural -> fold -> check;
}
