digraph ConstructorPatterns {
  rankdir=LR;
  node [shape=box];
  source [label="Named constructor prefix\nexplicit parameters + field names\nor typed binders"];
  type [label="Erased type check\ninfer field telescope or check annotations\nexact curried field quantities"];
  packing [label="Apply to fresh field variables\nbounded equality with canonical packing"];
  emit [label="Emit existing BoxCase / PairCase\nexplicit or inferred motive"];
  check [label="Independent core type/usage checking"];
  source -> type -> packing -> emit -> check;
  note [label="Structural aliases allowed\nnot nominal discrimination", style=dashed];
  packing -> note [style=dashed];
}
