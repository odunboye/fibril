digraph DirectDataCases {
  rankdir=LR;
  node [shape=box];
  source [label="Authored case\nexplicit motive + aligned branches"];
  infer [label="Infer scrutinee nominal type\nand actual variant shape"];
  compare [label="Bounded canonical constructor comparison\nindices + shape + tag + arity"];
  coverage [label="Exhaustive unique tags\norder branches by variant position"];
  assemble [label="NominalCase / VariantCase\nactual payload quantity + type"];
  check [label="Independent ordinary core checks\nerased stage + branch usage joins"];
  source -> infer -> compare -> coverage -> assemble -> check;
}
