digraph DirectDataCases {
  rankdir=LR;
  node [shape=box];
  source [label="Authored case\nexplicit/inferred motive + aligned branches"];
  infer [label="Infer scrutinee family\nnominal, unary recursive or list"];
  compare [label="Guarded canonical constructor comparison\nfamily + parameters + arity"];
  coverage [label="Exhaustive unique constructors\norder branches by checked shape"];
  assemble [label="NominalCase / RecCase / SeqCase\nchecked dependent payload binders"];
  check [label="Independent ordinary core checks\nerased stage + branch usage joins"];
  source -> infer -> compare -> coverage -> assemble -> check;
}
