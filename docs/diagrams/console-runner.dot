digraph ConsoleRunner {
  rankdir=LR;
  node [shape=box];
  source [label="Ordinary Fibril source\nincluding helpers and do"];
  library [label="Bundled Prelude.fib\nparse + runtime-check definitions"];
  resolve [label="Lexical/global resolution\nclosed values, not axioms"];
  check [label="Core runtime checking\nmain : IO Unit"];
  plan [label="Pure complete IO plan\ncheck + bounded reduction"];
  execute [label="Host stdout adapter\nonly after plan succeeds"];
  library -> resolve; source -> resolve; resolve -> check;
  check -> plan; plan -> execute;
}
