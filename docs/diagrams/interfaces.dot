digraph interfaces {
  rankdir=LR;
  node [shape=box, fontname="sans-serif"];
  operations [label="Implemented\nExplicit higher-order operations\nString + Bool examples"];
  staging [label="Implemented\nErased named globals\nStage-preserving lookup"];
  records [label="Implemented\nResource-budgeted dependent records\nUnary wrappers + nested pairs\nErased parameters, patterns, safe getters"];
  explicit [label="Implemented\nExplicit interfaces / named dictionaries\nChecked method getters\nLaw obligations separate"];
  search [label="Later\nCoherent bounded lookup\nGeneric operators", style=dashed];
  operations -> staging -> records -> explicit -> search;
}
