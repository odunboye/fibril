digraph ImplicitArguments {
  rankdir=LR;
  node [shape=box];
  source [label="Authored erased prefix\n+ direct global call"];
  metadata [label="Checked global visibility\nnot a certificate"];
  solve [label="Scoped incremental constraints\nargument types + expected result"];
  explicit [label="Explicit {argument}\nfor unsolved cases", style=dashed];
  core [label="Ordinary Pi + Apply\nno core metavariable"];
  check [label="Independent core + runtime check"];
  source -> metadata -> solve -> core -> check;
  solve -> explicit [style=dashed];
  explicit -> core [style=dashed];
}
