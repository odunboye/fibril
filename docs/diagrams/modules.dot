digraph Modules {
rankdir=LR; node [shape=box,style=rounded];
"Source.File" -> {"Source.UTF8" "Source.Text"};
Main -> {"Source.File" "Source.Lexer" "Source.Diagnostic"};
"Source.Diagnostic" -> "Source.Text";
"Source.Declaration" -> {Quantity "Source.Text" "Source.Lexer" "Source.Syntax" "Source.Parser"};
"Source.Lexer" -> {"Source.Text" "Source.StringLiteral"};
"Source.StringLiteral" -> "Source.Text";
"Source.Console" -> {"Effect.Console" "Source.Text" "Source.Lexer" "Source.Parser"};
"Runtime.Console" -> "Effect.Console";
"Driver.Run" -> {Term "Source.File" "Source.Console" "Source.Diagnostic" "Effect.Console" "Runtime.Console" "Driver.Check"};
"Source.Syntax" -> {Quantity "Source.Lexer"};
"Source.Parser" -> {Quantity "Source.Text" "Source.Lexer" "Source.Syntax" "Source.StringLiteral"};
"Source.Resolve" -> {Term "Source.Text" "Source.Lexer" "Source.Syntax"};
"Driver.Check" -> {"Source.Text" "Source.Lexer" "Source.Syntax" "Source.Parser" "Source.Declaration" "Source.Console" "Source.StringLiteral" "Source.Resolve" "Source.File" "Source.Diagnostic" Term Context Pretty Erased Runtime};
Main -> {"Driver.Check" "Driver.Evaluate" "Driver.Run"};
"Driver.Evaluate" -> {Context Term Pretty Reduction Runtime "Source.File" "Source.Diagnostic" "Driver.Check"};
Quantity; Interval; NormalForm; Face; Scope; Restriction; Term;
NormalForm -> {Interval Sorted}; Face -> {Interval Sorted};
Scope -> {Interval Face}; Restriction -> {Interval Scope};
Demo -> {Quantity Term Context Usage Pretty Erased Runtime Interval NormalForm Face};
Main -> Demo;
Pretty -> {Quantity Term};
Term -> Quantity; Usage -> Quantity; Context -> {Quantity Term Usage};
Reduction -> Term; WeakHead -> Term;
Compatibility -> {Term Reduction};
Renaming -> Term;
Substitution -> {Term Renaming};
"Substitution.Composition" -> {Term Renaming Substitution};
"Substitution.Instantiation" -> {Term Substitution "Substitution.Composition"};
"Reduction.Beta" -> {Quantity Term Reduction "Substitution.Instantiation"};
"Reduction.Fuel" -> {Term Reduction};
Erased -> {Quantity Term Pretty Context Compatibility WeakHead Reduction};
Runtime -> {Quantity Term Context Usage WeakHead Erased};
label="Implemented direct Fibril imports (importer → dependency)";
}