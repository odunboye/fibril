digraph ProjectCreation {
  rankdir=LR;
  node [shape=box];
  cli [label="fibril new NAME\nvalidate name + optional explicit namespace"];
  plan [label="Pure bundled console plan\nMain + README + gitignore\noptional namespace-selected fibril.yaml"];
  preview [label="--dry-run\nno filesystem probes or writes"];
  admit [label="Trusted POSIX cwd\nfresh private mkdir"];
  files [label="Exclusive fopen wx\nchecked write + close"];
  error [label="Failure: stop and report\nretain partial output; no rollback"];
  cli -> plan;
  plan -> preview;
  plan -> admit -> files;
  admit -> error [style=dashed];
  files -> error [style=dashed];
}
