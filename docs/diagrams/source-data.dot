digraph SourceData {
  rankdir=LR;
  node [shape=box];
  authored [label="Authored non-recursive data\nreal type/constructor/field tokens"];
  lowering [label="Qualified key + named IR preflight\nnullary / direct unary / dependent telescope"];
  core [label="Nominal + variant ordinary core\nindependent checking of every definition"];
  helper [label="Optional consuming eliminator\nunrestricted branch arguments"];
  authored -> lowering -> core -> helper;
  next [label="Direct zero/unary source cases\nrecursive data and termination separate", style=dashed];
  helper -> next [style=dashed];
}
